{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-file-icons",
  "category": "appearance",
  "name": {
    "zh": "自定义图标",
    "en": "Custom Icons"
  },
  "version": "1.0.0",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-file-icons",
  "summary": {
    "zh": "为侧栏笔记和文件夹更换 96 款双色矢量图标，支持 7 种柔和色调与标签页同步显示",
    "en": "Customize sidebar notes and folders with 96 two-tone icons, 7 soft tints, and optional tab sync"
  },
  "entry": {
    "command": [
      "python3",
      "-u",
      "main.py"
    ]
  },
  "permissions": [
    "storage",
    "ui:sidebar"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "保存图标选择器的交互开关与标签页同步偏好设置",
      "en": "Save sidebar icon picker and tab sync preferences"
    },
    "ui:sidebar": {
      "zh": "读取和更新当前笔记本的侧栏文件与文件夹自定义图标",
      "en": "Read and update custom icons for sidebar files and folders"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "contributes": {
    "file_icons": [
      {
        "id": "ocean-icons",
        "title": {
          "zh": "自定义图标",
          "en": "Custom Icons"
        },
        "pack": "icons.json",
        "picker": true,
        "sync_tabs": true
      }
    ]
  },
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
      "M5 4.25H13.5L17.75 8.5V18.25A1.5 1.5 0 0 1 16.25 19.75H5A1.5 1.5 0 0 1 3.5 18.25V5.75A1.5 1.5 0 0 1 5 4.25Z"
    ],
    "stroke_paths": [
      "M5 4.25H13.5L17.75 8.5V18.25A1.5 1.5 0 0 1 16.25 19.75H5A1.5 1.5 0 0 1 3.5 18.25V5.75A1.5 1.5 0 0 1 5 4.25Z",
      "M13.5 4.25V8.5H17.75",
      "M7 12.25H12",
      "M7 15.5H10.5"
    ],
    "accent_paths": [
      "M18.25 12.25V16.75M16 14.5H20.5",
      "M18.25 4.25L18.85 5.65L20.25 6.25L18.85 6.85L18.25 8.25L17.65 6.85L16.25 6.25L17.65 5.65Z"
    ]
  }
}
